process {
    container     = 'wchen27/histoqc-cpu:2.0-f35e518'
    cpus          = 1
    memory        = '4 GB'
    errorStrategy = 'retry'
    maxRetries    = 1
}

docker.enabled = true

profiles {
    mac {
        docker.runOptions = '--platform linux/amd64'
        executor.cpus     = 4
    }
}
